@{
    ViewData["Title"] = "AirIQ Demand Calculator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    body[data-layout="horizontal"] .page-content, .page-content {
        padding-top: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 60px !important;
    }

    :root {
        --brand-blue: #1076bb;
        --brand-red: #f16367;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-300: #cbd5e1;
        --slate-400: #94a3b8;
        --slate-500: #64748b;
        --slate-600: #475569;
        --slate-700: #334155;
        --slate-800: #1e293b;
        --slate-900: #0f172a;
    }

    .custom-scope {
        font-family: 'Inter', sans-serif;
        background-color: var(--slate-50);
        color: var(--slate-900);
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-up {
        animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes barFill {
        from {
            width: 0;
        }
    }

    .animate-bar-fill {
        animation: barFill 1s ease-out forwards;
    }

    /* Hero Banner */
    .hero-banner {
        background: linear-gradient(135deg, var(--brand-blue) 0%, var(--brand-red) 100%);
        padding-top: 2.5rem;
        padding-bottom: 7rem;
        position: relative;
    }

    .hero-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0);
        background-size: 24px 24px;
    }

    /* Modern Inputs */
    .modern-input {
        background-color: var(--slate-50);
        border: 1px solid var(--slate-200);
        border-radius: 0.75rem;
        padding: 0.5rem 1rem;
        color: var(--slate-800);
        font-size: 0.875rem;
        font-weight: 500;
        height: 38px;
        transition: all 0.2s;
        outline: none;
        width: 100%;
    }

        .modern-input:focus {
            background-color: #fff;
            border-color: var(--brand-blue);
            box-shadow: 0 0 0 4px rgba(16, 118, 187, 0.1);
        }

    .input-icon-wrapper {
        position: relative;
    }

        .input-icon-wrapper .lucide {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--slate-400);
            width: 1rem;
            height: 1rem;
        }

        .input-icon-wrapper input {
            padding-left: 2.5rem;
        }

    /* Date Filter Box */
    .date-filter-box {
        background-color: var(--slate-50);
        border-radius: 0.75rem;
        padding: 0.75rem;
        height: 100%;
    }

    .date-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        margin-bottom: 0.25rem;
        display: block;
        letter-spacing: 0.05em;
    }

    .custom-date-wrap {
        background-color: #fff;
        border: 1px solid var(--slate-200);
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        overflow: hidden;
        height: 36px;
    }

        .custom-date-wrap input[type="date"] {
            border: none;
            box-shadow: none;
            padding: 0.25rem 0.75rem;
            font-weight: 600;
            color: var(--slate-700);
            cursor: pointer;
            flex-grow: 1;
            height: 100%;
            outline: none;
            font-size: 0.8125rem;
        }

            .custom-date-wrap input[type="date"]:focus {
                background-color: var(--slate-50);
            }

        .custom-date-wrap .separator {
            color: var(--slate-400);
            font-size: 0.75rem;
            padding: 0 0.5rem;
            font-weight: 600;
        }

    /* CUSTOM LIST VIEW TABLE STYLES - STACKED DESIGN */
    .modern-table-wrapper {
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid var(--slate-200);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.8125rem;
    }
    
        .modern-table thead th {
            background-color: var(--slate-50);
            color: var(--slate-600);
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem 0.75rem;
            border-bottom: 1px solid var(--slate-200);
            cursor: pointer;
            user-select: none;
            transition: background-color 0.2s;
            white-space: nowrap;
        }

            .modern-table thead th:hover {
                background-color: #e2e8f0;
            }
    
        .modern-table tbody td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            color: var(--slate-700);
            font-weight: 500;
        }

        .modern-table tbody tr.main-row {
            transition: background-color 0.2s;
            cursor: pointer;
        }

            .modern-table tbody tr.main-row:hover {
                background-color: rgba(248, 250, 252, 0.8);
            }

    .sort-icon {
        width: 12px;
        height: 12px;
        transition: opacity 0.2s, color 0.2s;
        opacity: 0.3;
        margin-left: 4px;
    }

        .sort-icon.active {
            opacity: 1;
            color: var(--brand-blue);
        }

    .chevron-icon {
        transition: transform 0.2s ease;
    }

    .text-xxs {
        font-size: 0.65rem;
    }

    /* Badges */
    .band-very-high {
        background-color: #ffe4e6;
        color: #e11d48;
        border: 1px solid #fecdd3;
    }

    .band-high {
        background-color: #fef3c7;
        color: #d97706;
        border: 1px solid #fde68a;
    }

    .band-moderate {
        background-color: #e0f2fe;
        color: #0284c7;
        border: 1px solid #bae6fd;
    }

    .band-low {
        background-color: #d1fae5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .band-very-low {
        background-color: var(--slate-100);
        color: var(--slate-600);
        border: 1px solid var(--slate-200);
    }

    .band-na {
        background-color: #f1f5f9;
        color: #94a3b8;
        border: 1px solid #e2e8f0;
    }
</style>

<div class="page-content custom-scope pb-5">
    
    <!-- 1. HERO BANNER -->
    <div class="hero-banner px-3">
        <div class="hero-pattern"></div>
        <div class="container-fluid position-relative z-1" style="max-width: 1800px;">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div class="text-white">
                    <h1 class="fw-bolder mb-1 text-white d-flex align-items-center gap-3" style="font-size: 2.25rem;">
                        AirIQ Demand Analytics
                    </h1>
                    <p class="mb-0 fw-medium opacity-75" style="font-size: 1rem;">Live maturity-adjusted demand bands derived from ClickHouse log analytics.</p>
                </div>
                
                <div class="d-flex flex-column flex-sm-row items-end sm-items-center gap-3">
                    <div id="lastUpdatedText" class="d-flex align-items-center gap-2 text-white bg-dark bg-opacity-25 px-3 py-2 rounded-3 border border-light border-opacity-25" style="font-size: 0.8125rem; font-weight: 700; backdrop-filter: blur(10px);">
                        <i data-lucide="loader-2" class="lucide-spin" style="width: 1rem; height: 1rem;"></i> Loading live data...
                    </div>
                    <button class="btn btn-light fw-bold shadow-sm d-flex align-items-center gap-2 px-4" style="height: 38px; border-radius: 0.5rem; color: var(--brand-blue);" onclick="loadDemandData()">
                        <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem;"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. FILTER BAR -->
    <div class="container-fluid position-relative px-3" style="max-width: 1600px; margin-top: -3.5rem; z-index: 10;">
        <div class="card border-0 rounded-4 shadow-sm p-4 mb-4">
            
            <div class="d-flex align-items-center gap-2 mb-3">
                <i data-lucide="list-filter" class="text-primary" style="width: 1.25rem; height: 1.25rem;"></i>
                <h5 class="fw-bold mb-0 text-dark" style="font-size: 1rem;">Smart Filters</h5>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-xl-4">
                    <div class="date-filter-box mb-0 shadow-sm border">
                        <span class="date-label">Travel Date Range</span>
                        <div class="custom-date-wrap">
                            <input type="date" id="demandStartDate" onchange="loadDemandData()" required />
                            <span class="separator">to</span>
                            <input type="date" id="demandEndDate" onchange="loadDemandData()" required />
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label text-muted text-xxs fw-bold text-uppercase mb-1">Demand Band (Today)</label>
                    <select id="filterBand" class="form-select modern-input shadow-sm cursor-pointer">
                        <option value="">All Bands</option>
                        <option value="VERY HIGH">Very High</option>
                        <option value="HIGH">High</option>
                        <option value="MODERATE">Moderate</option>
                        <option value="LOW">Low</option>
                        <option value="VERY LOW">Very Low</option>
                        <option value="NA">No Fare Data (NA)</option>
                    </select>
                </div>
                
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label text-muted text-xxs fw-bold text-uppercase mb-1">Min Searches (Today)</label>
                    <input type="number" id="filterSearchVolume" class="form-control modern-input shadow-sm" placeholder="e.g. 50000">
                </div>
                
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label text-muted text-xxs fw-bold text-uppercase mb-1">Fare Delta Direction</label>
                    <select id="filterFareDelta" class="form-select modern-input shadow-sm cursor-pointer">
                        <option value="">All Deltas</option>
                        <option value="positive">Fares Rising (+)</option>
                        <option value="negative">Fares Dropping (-)</option>
                    </select>
                </div>
                
                <div class="col-6 col-md-3 col-xl-2 d-flex flex-column gap-2">
                    <button class="btn btn-outline-secondary w-100 shadow-sm fw-bold" style="height: 38px; border-radius: 0.5rem; font-size: 0.8125rem;" onclick="clearFilters()">
                        Clear Filters
                    </button>
                </div>
            </div>

            <hr class="text-muted opacity-25 my-4">

            <div class="d-flex justify-content-between align-items-center">
                <div class="input-icon-wrapper" style="max-width: 350px; width: 100%;">
                    <i data-lucide="search"></i>
                    <input type="text" id="searchInput" placeholder="Quick Find Sector..." class="form-control modern-input w-100 shadow-sm">
                </div>
                <div class="text-muted fw-bold" style="font-size: 0.875rem;">
                    Showing <span id="visibleCount" class="text-dark">0</span> entries
                </div>
            </div>
        </div>

        <!-- 3. MAIN DATA TABLE AREA -->
        <div id="loading-overlay" class="text-center py-5 bg-white rounded-4 border shadow-sm animate-fade-up">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h4 class="fw-bold" style="color: var(--slate-800);">Analyzing ClickHouse Logs...</h4>
            <p class="text-muted mb-0">Computing live maturity-adjusted demand bands.</p>
        </div>

        <div id="render-container" class="animate-fade-up" style="display: none;">
            <!-- HTML injected via JS -->
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // --- STATE MANAGEMENT ---
        let allDemandData = [];
        let filteredData = [];
        
        let state = {
            search: '',
            band: '',
            minVol: 0,
            fareDelta: '',
            sortBy: 'rank',
            sortOrder: 'asc'
        };

        const formatNum = (num) => typeof num === 'number' ? num.toLocaleString('en-IN') : '-';
        
        // Setup initial default dates (+3 to +7 days)
        const formatYMD = (dateObj) => {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        };

        $(document).ready(function () {
            lucide.createIcons();

            let defaultStart = new Date();
            defaultStart.setDate(defaultStart.getDate() + 3);
            let defaultEnd = new Date(defaultStart);
            defaultEnd.setDate(defaultEnd.getDate() + 7);

            document.getElementById('demandStartDate').value = formatYMD(defaultStart);
            document.getElementById('demandEndDate').value = formatYMD(defaultEnd);

            // Bind Event Listeners
            document.getElementById('searchInput').addEventListener('input', (e) => { state.search = e.target.value.toLowerCase().trim(); processAndRender(); });
            document.getElementById('filterBand').addEventListener('change', (e) => { state.band = e.target.value; processAndRender(); });
            document.getElementById('filterSearchVolume').addEventListener('input', (e) => { state.minVol = parseInt(e.target.value) || 0; processAndRender(); });
            document.getElementById('filterFareDelta').addEventListener('change', (e) => { state.fareDelta = e.target.value; processAndRender(); });

            loadDemandData();
        });

        // --- DATA FETCHING ---
        function loadDemandData() {
            $('#render-container').hide();
            $('#loading-overlay').show();
            
            $('#lastUpdatedText').html('<i data-lucide="loader-2" class="lucide-spin" style="width: 1rem; height: 1rem;"></i> Syncing Dates...');
            lucide.createIcons();

            let sd = document.getElementById('demandStartDate').value;
            let ed = document.getElementById('demandEndDate').value;

            $.ajax({
                url: `/Demand/GetDemandData?startDate=${sd}&endDate=${ed}`,
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data) {
                        let safeData = res.data.map(row => {
                            let newRow = {};
                            for (let key in row) {
                                let camelKey = key.charAt(0).toLowerCase() + key.slice(1);
                                newRow[camelKey] = row[key];
                            }
                            return newRow;
                        });

                        safeData.sort((a, b) => {
                            let scoreA = typeof a.scoreToday === 'number' ? a.scoreToday : -1;
                            let scoreB = typeof b.scoreToday === 'number' ? b.scoreToday : -1;
                            return scoreB - scoreA;
                        });
                        safeData.forEach((row, index) => { row.rank = index + 1; });

                        allDemandData = safeData;
                        
                        updateTimestamp();
                        $('#loading-overlay').hide();
                        $('#render-container').show();
                        processAndRender();
                    } else {
                        updateTimestamp("Processing");
                        alert(res.message || "Background worker is computing data. Please wait.");
                    }
                },
                error: function (err) {
                    console.error("Failed to load demand data", err);
                    updateTimestamp("Connection Error");
                    $('#loading-overlay').hide();
                }
            });
        }

        function updateTimestamp(overrideMsg) {
            if (overrideMsg) {
                $('#lastUpdatedText').removeClass('bg-dark').addClass('bg-danger').html(`<i data-lucide="alert-circle" style="width: 1rem; height: 1rem;"></i> ${overrideMsg}`);
            } else {
                const now = new Date();
                const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                $('#lastUpdatedText').removeClass('bg-dark bg-danger').addClass('bg-success').html(`<i data-lucide="check-circle-2" style="width: 1rem; height: 1rem;"></i> Updated: ${timeString}`);
            }
            lucide.createIcons();
        }

        function clearFilters() {
            document.getElementById('filterBand').value = '';
            document.getElementById('filterSearchVolume').value = '';
            document.getElementById('filterFareDelta').value = '';
            document.getElementById('searchInput').value = '';
            
            state.search = '';
            state.band = '';
            state.minVol = 0;
            state.fareDelta = '';

            let defaultStart = new Date();
            defaultStart.setDate(defaultStart.getDate() + 3);
            let defaultEnd = new Date(defaultStart);
            defaultEnd.setDate(defaultEnd.getDate() + 7);
            
            document.getElementById('demandStartDate').value = formatYMD(defaultStart);
            document.getElementById('demandEndDate').value = formatYMD(defaultEnd);

            loadDemandData();
        }

        // --- GLOBAL UI HANDLERS ---
        window.handleSort = function (column) {
            if (state.sortBy === column) {
                state.sortOrder = state.sortOrder === 'asc' ? 'desc' : 'asc';
            } else {
                state.sortBy = column;
                state.sortOrder = 'asc';
            }
            processAndRender();
        };

        window.toggleRow = function (index) {
            if (window.innerWidth >= 1400) return; // Disable natively on XXL screens
            const expandRow = document.getElementById(`expand-${index}`);
            const chevron = document.getElementById(`chev-${index}`);
            if (expandRow.classList.contains('d-none')) {
                expandRow.classList.remove('d-none');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
            } else {
                expandRow.classList.add('d-none');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        };

        // --- PROCESSING & RENDERING ---
        function processAndRender() {
            // 1. Filter
            filteredData = allDemandData.filter(row => {
                if (state.search && !(row.sector && row.sector.toLowerCase().includes(state.search))) return false;
                if (state.band && row.bandToday !== state.band) return false;
                if (state.minVol > 0 && row.searchToday < state.minVol) return false;
                if (state.fareDelta) {
                    if (typeof row.fareMultiplier !== 'number') return false;
                    let isPositive = row.fareMultiplier > 1.0;
                    if (state.fareDelta === 'positive' && !isPositive) return false;
                    if (state.fareDelta === 'negative' && isPositive) return false;
                }
                return true;
            });

            document.getElementById('visibleCount').textContent = formatNum(filteredData.length);

            // 2. Sort
            filteredData.sort((a, b) => {
                let vA, vB;
                switch (state.sortBy) {
                    case 'rank': vA = a.rank; vB = b.rank; break;
                    case 'sector': vA = (a.sector || "").toLowerCase(); vB = (b.sector || "").toLowerCase(); break;
                    case 'tdate': vA = new Date(a.travelDate || 0).getTime(); vB = new Date(b.travelDate || 0).getTime(); break;
                    case 'stoday': vA = a.searchToday || 0; vB = b.searchToday || 0; break;
                    case 'ftoday': vA = a.fareToday || 0; vB = b.fareToday || 0; break;
                    case 'scoret': vA = a.scoreToday || 0; vB = b.scoreToday || 0; break;
                    case 'scorea': vA = a.score7Day || 0; vB = b.score7Day || 0; break;
                    default: vA = a.rank; vB = b.rank;
                }
                if (vA < vB) return state.sortOrder === 'asc' ? -1 : 1;
                if (vA > vB) return state.sortOrder === 'asc' ? 1 : -1;
                return 0;
            });

            // 3. Render
            const container = document.getElementById('render-container');
            if (filteredData.length === 0) {
                container.innerHTML = `
                            <div class="text-center py-5 bg-white rounded-4 border shadow-sm mb-5">
                                <i data-lucide="search-x" class="text-muted mb-3" style="width: 3rem; height: 3rem; opacity: 0.5;"></i>
                                <h4 class="fw-bold" style="color: var(--slate-800);">No results found</h4>
                                <p class="text-muted mb-0">Try clearing or adjusting your filters.</p>
                            </div>`;
            } else {
                container.innerHTML = buildListView(filteredData);
            }
            lucide.createIcons();
        }

        // --- HTML BUILDER ---
        const renderDelta = (val) => {
            if (typeof val !== 'number') return `<span class="text-muted fw-bold text-xxs">NA</span>`;
            if (val > 0) return `<span class="text-success fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="trending-up" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
            if (val < 0) return `<span class="text-danger fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="trending-down" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
            return `<span class="text-muted fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="minus" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
        };

        const renderFareDelta = (val) => {
            if (typeof val !== 'number') return `<span class="text-muted fw-bold text-xxs">NA</span>`;
            if (val > 0) return `<span class="text-danger fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="trending-up" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
            if (val < 0) return `<span class="text-success fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="trending-down" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
            return `<span class="text-muted fw-bolder d-flex align-items-center justify-content-end gap-1"><i data-lucide="minus" style="width: 12px; height: 12px;"></i> ${(val * 100).toFixed(1)}%</span>`;
        };

        const renderBandBadge = (band) => {
            if (!band || band === "NA") return `<span class="badge band-na px-2 py-1 shadow-sm">NA</span>`;
            let b = band.toUpperCase();
            if (b === "VERY HIGH") return `<span class="badge band-very-high px-2 py-1 shadow-sm">VERY HIGH</span>`;
            if (b === "HIGH") return `<span class="badge band-high px-2 py-1 shadow-sm">HIGH</span>`;
            if (b === "MODERATE") return `<span class="badge band-moderate px-2 py-1 shadow-sm">MODERATE</span>`;
            if (b === "LOW") return `<span class="badge band-low px-2 py-1 shadow-sm">LOW</span>`;
            if (b === "VERY LOW") return `<span class="badge band-very-low px-2 py-1 shadow-sm">VERY LOW</span>`;
            return `<span class="badge band-na px-2 py-1">${b}</span>`;
        };

        function buildListView(records) {
            const getIcon = (col) => {
                const isActive = state.sortBy === col;
                const icon = isActive ? (state.sortOrder === 'asc' ? 'arrow-up' : 'arrow-down') : 'arrow-up-down';
                const activeCls = isActive ? 'active' : '';
                return `<i data-lucide="${icon}" class="sort-icon ${activeCls}"></i>`;
            };

            // By stacking the secondary elements (like '7D Avg') inside the primary data cells,
            // we shrink the total column count from 15 to 7, entirely removing horizontal scrolling while keeping 100% of the data.
            let html = `
                    <div class="modern-table-wrapper mb-5">
                        <table class="modern-table w-100">
                            <thead>
                                <tr>
                                    <th onclick="handleSort('rank')" class="text-center" style="width: 60px;"><div class="d-flex justify-content-center align-items-center">Rank ${getIcon('rank')}</div></th>
                                    <th onclick="handleSort('sector')"><div class="d-flex align-items-center">Sector ${getIcon('sector')}</div></th>
                                    <th onclick="handleSort('tdate')"><div class="d-flex align-items-center">Travel Info ${getIcon('tdate')}</div></th>
                                    <th onclick="handleSort('stoday')" class="d-none d-sm-table-cell text-end"><div class="d-flex justify-content-end align-items-center">Searches (Vol) ${getIcon('stoday')}</div></th>
                                    <th onclick="handleSort('ftoday')" class="d-none d-md-table-cell text-end"><div class="d-flex justify-content-end align-items-center">Fares (INR) ${getIcon('ftoday')}</div></th>
                                    <th onclick="handleSort('scoret')" class="d-none d-lg-table-cell border-start" style="background-color: var(--slate-100);"><div class="d-flex align-items-center">Today's Demand ${getIcon('scoret')}</div></th>
                                    <th onclick="handleSort('scorea')" class="d-none d-xxl-table-cell" style="background-color: var(--slate-100);"><div class="d-flex align-items-center">7D Avg Demand ${getIcon('scorea')}</div></th>
                                    <th class="text-center d-xxl-none">More</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;

            records.forEach((row, index) => {
                const matVal = typeof row.maturity === 'number' ? row.maturity : 0;
                const maturityPct = (matVal * 100).toFixed(0);
                
                const fTodayStr = typeof row.fareToday === 'number' ? `₹${formatNum(row.fareToday)}` : `<span class="text-muted fw-bold">NA</span>`;
                const fAvgStr = typeof row.fare7DayAvg === 'number' ? `₹${formatNum(row.fare7DayAvg)}` : `<span class="text-muted fw-bold">NA</span>`;
                const multStr = typeof row.fareMultiplier === 'number' ? `${row.fareMultiplier.toFixed(2)}x` : `<span class="text-muted fw-bold">NA</span>`;
                
                const scTodayStr = typeof row.scoreToday === 'number' ? row.scoreToday.toFixed(3) : `NA`;
                const scAvgStr = typeof row.score7Day === 'number' ? row.score7Day.toFixed(3) : `NA`;

                html += `
                            <!-- Main Visible Row -->
                            <tr class="main-row" onclick="toggleRow(${index})">
                                <td class="text-center"><span class="fw-bold text-muted" style="font-size: 0.8125rem;">${row.rank}</span></td>
                                <td class="fw-bold text-dark fs-6">${row.sector || '-'}</td>
                        
                                <td>
                                    <div class="fw-bold text-dark">${row.travelDate || '-'}</div>
                                    <div class="text-muted text-xxs mt-1 fw-bold">CAP: <span class="text-slate-700">${row.capacity || 0}</span> <span class="mx-1 opacity-25">•</span> DAYS OUT: <span class="text-slate-700">${row.daysToTravel || 0}</span></div>
                                </td>
                        
                                <td class="d-none d-sm-table-cell">
                                    <div class="d-flex justify-content-end align-items-center gap-4">
                                        <div class="text-end">
                                            <div class="fw-bolder text-slate-800" style="font-size: 0.95rem;">${formatNum(row.searchToday)}</div>
                                            <div class="text-muted text-xxs mt-1 fw-bold">7D AVG: ${formatNum(row.search7DayAvg)}</div>
                                        </div>
                                        <div style="min-width: 60px;">${renderDelta(row.searchDelta)}</div>
                                    </div>
                                </td>

                                <td class="d-none d-md-table-cell">
                                    <div class="d-flex justify-content-end align-items-center gap-4">
                                        <div class="text-end">
                                            <div class="fw-bolder text-slate-800" style="font-size: 0.95rem;">${fTodayStr}</div>
                                            <div class="text-muted text-xxs mt-1 fw-bold">7D AVG: ${fAvgStr} <span class="mx-1 opacity-25">•</span> MULT: <span class="text-slate-700">${multStr}</span></div>
                                        </div>
                                        <div style="min-width: 60px;">${renderFareDelta(row.fareDelta)}</div>
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell border-start" style="background-color: var(--slate-50);">
                                    <div class="d-flex flex-column gap-2 pe-3">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="fw-bolder text-dark" style="font-size: 0.95rem;">${scTodayStr}</span>
                                            ${renderBandBadge(row.bandToday)}
                                        </div>
                                        <div class="d-flex align-items-center gap-2" title="Maturity: ${matVal.toFixed(2)}">
                                            <div class="progress shadow-sm w-100" style="height: 5px; background-color: var(--slate-200);">
                                                <div class="progress-bar animate-bar-fill rounded-pill" style="background-color: #6366f1; width: ${maturityPct}%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="d-none d-xxl-table-cell" style="background-color: var(--slate-50);">
                                    <div class="d-flex flex-column gap-2 pe-3">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="fw-bolder text-slate-600" style="font-size: 0.95rem;">${scAvgStr}</span>
                                            ${renderBandBadge(row.band7Day)}
                                        </div>
                                    </div>
                                </td>
                        
                                <td class="text-center d-xxl-none">
                                    <button class="btn btn-light btn-sm border text-muted shadow-sm px-2">
                                        <i data-lucide="chevron-down" id="chev-${index}" class="chevron-icon" style="width: 1.25rem; height: 1.25rem;"></i>
                                    </button>
                                </td>
                            </tr>
                    
                            <!-- Expanded Details Row (Mobile/Tablet/Laptop Only) -->
                            <tr id="expand-${index}" class="expanded-row d-none d-xxl-none">
                                <td colspan="8" class="p-0 border-0">
                                    <div class="p-4" style="background-color: rgba(248, 250, 252, 0.5);">
                                        <div class="row g-3">
                                            <div class="col-12 col-sm-6 d-md-none">
                                                <div class="text-xxs fw-bold text-muted text-uppercase mb-2">Searches (Vol)</div>
                                                <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded-3 border shadow-sm">
                                                    <div>
                                                        <div class="fw-bolder text-dark">${formatNum(row.searchToday)}</div>
                                                        <div class="text-xs text-muted mt-1">7D Avg: ${formatNum(row.search7DayAvg)}</div>
                                                    </div>
                                                    <div>${renderDelta(row.searchDelta)}</div>
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-6 d-md-none">
                                                <div class="text-xxs fw-bold text-muted text-uppercase mb-2">Fares (INR)</div>
                                                <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded-3 border shadow-sm">
                                                    <div>
                                                        <div class="fw-bolder text-dark">${fTodayStr}</div>
                                                        <div class="text-xs text-muted mt-1">7D Avg: ${fAvgStr} | Mult: ${multStr}</div>
                                                    </div>
                                                    <div>${renderFareDelta(row.fareDelta)}</div>
                                                </div>
                                            </div>

                                            <div class="col-12 col-md-6 d-lg-none">
                                                <div class="text-xxs fw-bold text-muted text-uppercase mb-2">Today's Demand</div>
                                                <div class="d-flex flex-column gap-2 bg-white p-3 rounded-3 border shadow-sm">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <span class="fw-bolder text-dark" style="font-size: 0.95rem;">${scTodayStr}</span>
                                                        ${renderBandBadge(row.bandToday)}
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2 mt-1">
                                                        <span class="text-xxs fw-bold text-muted" style="width: 50px;">Maturity</span>
                                                        <div class="progress shadow-sm w-100" style="height: 5px; background-color: var(--slate-200);">
                                                            <div class="progress-bar rounded-pill" style="background-color: #6366f1; width: ${maturityPct}%"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-12 col-md-6 d-xxl-none">
                                                <div class="text-xxs fw-bold text-muted text-uppercase mb-2">7D Avg Demand</div>
                                                <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded-3 border shadow-sm">
                                                    <span class="fw-bolder text-slate-600" style="font-size: 0.95rem;">${scAvgStr}</span>
                                                    ${renderBandBadge(row.band7Day)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        `;
            });

            html += `</tbody></table></div>`;
            return html;
        }
    </script>
}