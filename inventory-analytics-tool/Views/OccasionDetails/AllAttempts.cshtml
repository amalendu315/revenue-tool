                                    <td class="d-none d-lg-table-cell text-center fw-bold text-muted">${row.AirlineCode || ''}</td>
                                    <td class="d-none d-lg-table-cell text-center text-muted">${row.cleanFlightCode}</td>
                                    <td class="text-center fw-bold text-dark">${row.Pax || ''}</td>
