                                    <td class="text-center">${getStatusBadge(row.Status)}</td>
                                    <td class="d-none d-xl-table-cell text-end">${row.NegFare || '-'}</td>
                                    <td class="d-none d-lg-table-cell text-center">${getConfBadge(row.ConfStatus)}</td>
                                    <td class="d-none d-xxl-table-cell text-muted text-truncate" style="max-width: 150px;"><small>${row.Remarks || '-'}</small></td>
