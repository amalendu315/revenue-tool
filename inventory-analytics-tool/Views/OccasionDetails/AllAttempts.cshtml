                                                <div class="col-6 col-md-4 d-xl-none"><div class="text-xxs fw-bold text-muted text-uppercase mb-1">Entry Date</div><div class="fw-bold text-muted" style="font-size: 0.75rem;">${row.EntryDate || '-'}</div></div>
                                                <div class="col-6 col-md-4 d-xl-none"><div class="text-xxs fw-bold text-muted text-uppercase mb-1">Req ID</div><div class="fw-bold text-dark">${row.ReqId || '-'}</div></div>
                                                <div class="col-6 col-md-4 d-lg-none"><div class="text-xxs fw-bold text-muted text-uppercase mb-1">Airline</div><div class="fw-bold text-dark">${row.AirlineCode || '-'}</div></div>
                                                <div class="col-6 col-md-4 d-lg-none"><div class="text-xxs fw-bold text-muted text-uppercase mb-1">Flight</div><div class="fw-bold text-dark">${row.cleanFlightCode || '-'}</div></div>
