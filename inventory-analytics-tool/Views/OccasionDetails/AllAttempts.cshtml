                                            <th onclick="handleSort('destination')" class="text-center"><div class="d-flex justify-content-center align-items-center">Des ${getIcon('destination')}</div></th>
                                            <th onclick="handleSort('traveldate')" class="d-none d-md-table-cell"><div class="d-flex align-items-center">Travel Date ${getIcon('traveldate')}</div></th>
                                            <th onclick="handleSort('airline')" class="d-none d-lg-table-cell text-center"><div class="d-flex justify-content-center align-items-center">Airline ${getIcon('airline')}</div></th>
                                            <th onclick="handleSort('flight')" class="d-none d-lg-table-cell text-center"><div class="d-flex justify-content-center align-items-center">Flight ${getIcon('flight')}</div></th>
