        // --- EXPORT & IMPORT ---
        async function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const isConfirmed = confirm(`Are you sure you want to import ${file.name}?`);
            if (!isConfirmed) {
                event.target.value = '';
                return;
            }

            const btn = document.querySelector('.btn-import');
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Uploading...`;
            btn.disabled = true;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/OccasionDetails/UploadAttempts', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert('Upload failed: ' + result.message);
                }
            } catch (err) {
                alert('A network error occurred during upload: ' + err.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
                event.target.value = '';
            }
        }

        function exportAllToExcel() {
            const from = document.getElementById('serverFromDate').value || '';
            const to = document.getElementById('serverToDate').value || '';

            const fReqId = $('#filter-req-id').val();
            const fSector = $('#filter-sector').val();
            const fStation = $('#filter-station').val();
            const fAirline = $('#filter-airline').val();
            const fStatus = $('#filter-status').val();
            const fConf = $('#filter-conf-status').val();
            const fLead = $('#filter-lead').val();
            const fMonth = $('#filter-month').val();
            const fFlightNo = document.getElementById('filter-flight-no').value.trim();
            const fTravelDate = document.getElementById('filter-travel-date').value;
            
            let formattedTravelDate = '';
            if (fTravelDate) {
                const d = new Date(fTravelDate);
                const day = d.getDate().toString().padStart(2, '0');
                const month = d.toLocaleString('en-US', { month: 'short' });
                const year = d.getFullYear();
                formattedTravelDate = `${day} ${month} ${year}`;
            }

            const params = new URLSearchParams();
            if (from) params.append('fromDate', from);
            if (to) params.append('toDate', to);

            if (fReqId !== 'All') params.append('fReqId', fReqId);
            if (fSector !== 'All') params.append('fSector', fSector);
            if (fStation !== 'All') params.append('fStation', fStation);
            if (fAirline !== 'All') params.append('fAirline', fAirline);
            if (formattedTravelDate) params.append('fTravelDate', formattedTravelDate);
            if (fStatus !== 'All') params.append('fStatus', fStatus);
            if (fConf !== 'All') params.append('fConfStatus', fConf);
            if (fLead !== 'All') params.append('fLead', fLead);
            if (fFlightNo) params.append('fFlightNo', fFlightNo);
            if (fMonth !== 'All') params.append('fMonth', fMonth);

            window.location.href = `/OccasionDetails/ExportAllAttemptsToExcel?${params.toString()}`;
        }
    </script>
}