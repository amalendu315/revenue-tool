                                    <td class="d-none d-lg-table-cell text-center"><span class="badge bg-light text-dark border shadow-sm px-2 py-1">${row.Lead || '-'}</span></td>
                                    <td class="text-center d-xxl-none">
                                        <button class="btn btn-light btn-sm border text-muted shadow-sm px-2">
