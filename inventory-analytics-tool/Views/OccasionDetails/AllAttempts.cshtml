                                            <th onclick="handleSort('onlinefare')" class="d-none d-xl-table-cell text-end"><div class="d-flex justify-content-end align-items-center">Online Fare ${getIcon('onlinefare')}</div></th>
                                            <th onclick="handleSort('autoquote')" class="d-none d-xl-table-cell text-end"><div class="d-flex justify-content-end align-items-center">Auto Quote ${getIcon('autoquote')}</div></th>
                                            <th onclick="handleSort('status')" class="text-center"><div class="d-flex justify-content-center align-items-center">Status ${getIcon('status')}</div></th>
                                            <th onclick="handleSort('negfare')" class="d-none d-xl-table-cell text-end"><div class="d-flex justify-content-end align-items-center">Neg. Fare ${getIcon('negfare')}</div></th>
                                            <th onclick="handleSort('confstatus')" class="d-none d-lg-table-cell text-center"><div class="d-flex justify-content-center align-items-center">Conf. ${getIcon('confstatus')}</div></th>
                                            <th onclick="handleSort('remarks')" class="d-none d-xxl-table-cell"><div class="d-flex align-items-center">Remarks ${getIcon('remarks')}</div></th>
                                            <th onclick="handleSort('pnr')" class="d-none d-xl-table-cell"><div class="d-flex align-items-center">PNR ${getIcon('pnr')}</div></th>
                                            <th onclick="handleSort('openremarks')" class="d-none d-xxl-table-cell"><div class="d-flex align-items-center">Open Remarks ${getIcon('openremarks')}</div></th>
                                            <th onclick="handleSort('lead')" class="d-none d-lg-table-cell text-center"><div class="d-flex justify-content-center align-items-center">Lead ${getIcon('lead')}</div></th>
                                            <th class="text-center d-xxl-none">More</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

            records.forEach((row, index) => {
                html += `
                                <tr class="main-row" onclick="toggleRow(${index})">
                                    <td class="fw-bolder text-primary">${row.AqId || ''}</td>
