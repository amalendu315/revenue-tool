                const activeCls = isActive ? 'active' : '';
                return `<i data-lucide="${icon}" class="sort-icon ${activeCls}"></i>`;
            };

            const getStatusBadge = (status) => {
                let s = (status || '').trim();
                if (s === "PNR CREATED") return `<span class="badge bg-success status-badge">${s}</span>`;
