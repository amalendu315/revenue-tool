@model IEnumerable<inventory_analytics_tool.Models.AttemptRecord>
@{
    ViewData["Title"] = "Fare Trends Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    [data-layout=horizontal] .page-content {
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .clickable-row:hover {
            background-color: #f1f5f9 !important;
        }

    /* --- SLEEK DATE PICKER FIXES --- */
    .date-picker-wrapper {
        cursor: pointer;
        background-color: #fff;
        transition: all 0.2s ease;
    }

        .date-picker-wrapper:hover {
            border-color: #0b5ed7 !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15) !important;
        }

        .date-picker-wrapper input[type="date"] {
            cursor: pointer;
            background-color: transparent;
        }

            .date-picker-wrapper input[type="date"]:focus {
                outline: none;
                box-shadow: none;
            }

            .date-picker-wrapper input[type="date"]::-webkit-calendar-picker-indicator,
            .date-picker-wrapper input[type="date"]::-webkit-inner-spin-button,
            .date-picker-wrapper input[type="date"]::-webkit-clear-button {
                display: none;
                -webkit-appearance: none;
            }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="conatiner cox">
            <div class="row">
                <div class="col-12 d-flex justify-content-start align-items-center gap-3">
                    <a href="/OccasionDetails/FareDetails?eventId=@ViewBag.EventId&sector=@Uri.EscapeDataString(ViewBag.Sector)&sectorType=@ViewBag.SectorType" class="btn btn-sm btn-light border shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Back to Fare Details">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    </a>
                    <h4 class="mb-sm-0"> Flight Data: <span class="text-primary">@ViewBag.Sector</span> <small class="text-muted fs-5">(@Convert.ToDateTime(ViewBag.TravelDate).ToString("dd MMM yyyy"))</small></h4>
                </div>
            </div>
        </div>

        <div class="boxes position-relative bg-white shadow-sm rounded-4 p-4 mt-3 w-100">

            <div id="loading-overlay" style="padding: 4rem; text-align: center;">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="mt-3 text-muted">Analyzing Flights...</h5>
                <p class="text-muted small">Fetching available airlines for @ViewBag.Sector on this date.</p>
            </div>

            <div id="error-overlay" style="display:none; padding: 2rem; background: #fff3f3; border: 1px solid #ffcdd2; border-radius: 8px; margin: 1rem 0;">
                <h5 class="text-danger mb-2">Failed to load data</h5>
                <p id="error-message" class="text-danger mb-0"></p>
            </div>

            <div id="flight-table-overlay" style="display:none; margin-bottom: 40px; width: 100%;">
                <table id="flightTable" class="display responsive nowrap w-100" style="width:100%">
                    <thead>
                        <tr>
                            <th>Sector</th>
                            <th>DOJ</th>
                            <th>Airline Code</th>
                            <th>Flight Number</th>
                            <th>Target Fare</th>
                            <th>Latest Fare</th>
                            <th>Latest Entry Date</th>
                        </tr>
                    </thead>
                    <tbody id="flight-tbody">
                    </tbody>
                </table>
            </div>

            <div id="chart-loading" style="display:none; padding: 4rem; text-align: center;">
                <div class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="mt-3 text-muted" id="chart-loading-text">Building Master Chart...</h5>
                <p class="text-muted small">Extracting historical entry logs from database for all flights.</p>
            </div>

            <div id="chart-overlay" style="display:none; padding-top:20px; border-top: 2px dashed #e2e8f0; width: 100%;">
                <h4 id="chartTitle" class="mb-3 text-dark fw-bold">Combined Fare Trend</h4>

                <div class="bg-light border rounded-4 p-4 mb-4">
                    <div class="row g-3 align-items-end justify-content-start">
                        <div class="col-lg-3 col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-2">From Entry Date</label>
                            <div class="input-group shadow-sm date-picker-wrapper d-flex align-items-center" style="border-radius: 8px; overflow: hidden; border: 1px solid #dee2e6;" onclick="document.getElementById('startDate').showPicker()">
                                <span class="input-group-text bg-white border-0 text-primary pe-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                </span>
                                <input type="date" id="startDate" class="form-control border-0 ps-2 fw-bold text-dark" style="height: 45px;" onclick="this.showPicker(); event.stopPropagation();">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-2">To Entry Date</label>
                            <div class="input-group shadow-sm date-picker-wrapper d-flex align-items-center" style="border-radius: 8px; overflow: hidden; border: 1px solid #dee2e6;" onclick="document.getElementById('endDate').showPicker()">
                                <span class="input-group-text bg-white border-0 text-primary pe-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                </span>
                                <input type="date" id="endDate" class="form-control border-0 ps-2 fw-bold text-dark" style="height: 45px;" onclick="this.showPicker(); event.stopPropagation();">
                            </div>
                        </div>
                        <div class="col-lg-auto col-md-4">
                            <button id="btnFilterChart" class="btn btn-primary w-100 shadow-sm d-flex align-items-center justify-content-center gap-2" style="border-radius: 8px; font-weight: 600; padding: 10px 20px; height: 45px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path></svg>
                                Reload Chart
                            </button>
                        </div>
                    </div>

                    <div class="mt-3 text-muted small d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-info"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        <span>Showing the latest <strong>15 unique entry days</strong> of recorded fare history by default. Fares plotted at ₹0 ensure no data drops are hidden.</span>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-0">Toggle Flights</label>

                            <button id="btnToggleAll" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold px-3" onclick="toggleAllFlights()" style="font-size: 12px; transition: all 0.2s;">
                                Deselect All
                            </button>
                        </div>
                        <div class="flight-toggles d-flex flex-wrap gap-2" id="flightTogglesContainer">
                        </div>
                    </div>
                </div>

                <div class="chart-container w-100" style="position: relative; min-height: 500px; width: 100%;">
                    <canvas id="myChart"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let globalRawData = [];
        let myChart = null;

        const currentEventId = @ViewBag.EventId;
        const currentSector = '@ViewBag.Sector';
        const currentTravelDate = '@ViewBag.TravelDate';
        let allFlightsSelected = true;

        const chartColors = ['#1076bb', '#f16367', '#28a745', '#ffc107', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#0dcaf0'];
        function getColor(index) { return chartColors[index % chartColors.length]; }

        // --- CREATE CUSTOM GRAPH PAPER MARKER (Dot + Outer Circle) ---
        const attemptMarkerCanvas = document.createElement('canvas');
        attemptMarkerCanvas.width = 18;
        attemptMarkerCanvas.height = 18;
        const ctxMarker = attemptMarkerCanvas.getContext('2d');

        // Outer Circle
        ctxMarker.beginPath();
        ctxMarker.arc(9, 9, 7, 0, 2 * Math.PI);
        ctxMarker.strokeStyle = '#dc3545'; // Bootstrap Danger Red so it stands out globally
        ctxMarker.lineWidth = 1.5;
        ctxMarker.stroke();

        // Inner Dot
        ctxMarker.beginPath();
        ctxMarker.arc(9, 9, 2.5, 0, 2 * Math.PI);
        ctxMarker.fillStyle = '#dc3545';
        ctxMarker.fill();

        document.addEventListener('DOMContentLoaded', function () {
        fetch(`/OccasionDetails/GetFlightLevelFares?eventId=${currentEventId}&sector=${encodeURIComponent(currentSector)}&date=${encodeURIComponent(currentTravelDate)}&year=2026`)
        .then(res => res.json())
        .then(result => {
        document.getElementById('loading-overlay').style.display = 'none';

        if (!result.success || !result.data) {
        showError("Failed to fetch flight list from API.");
        return;
        }

        if (result.data.length === 0) {
        showError("No specific flight numbers available for this sector on the selected travel date.");
        return;
        }

        document.getElementById('flight-table-overlay').style.display = 'block';
        renderFlightTable(result.data);

        // Immediately bulk fetch history for all flights returned
        loadAllChartData(result.data);
        })
        .catch(err => {
        document.getElementById('loading-overlay').style.display = 'none';
        showError("Network error: " + err.message);
        });

        document.getElementById('btnFilterChart').addEventListener('click', updateChartFilters);
        });

        function renderFlightTable(data) {
        if ($.fn.DataTable.isDataTable('#flightTable')) {
        $('#flightTable').DataTable().destroy();
        }

        let table = $('#flightTable').DataTable({
        responsive: true,
        paging: false,
        scrollY: "400px",
        scrollCollapse: true,
        language: { search: "_INPUT_", searchPlaceholder: "Search flights..." },
        columnDefs: [
        {
        targets: 4,
        render: function (data, type, row) {
        if (type === 'display' || type === 'filter') {
        return data > 0 ? '₹' + data.toLocaleString('en-IN') : 'N/A';
        }
        return data;
        }
        },
        {
        targets: 5,
        render: function (data, type, row) {
        if (type === 'display' || type === 'filter') {
        return data > 0 ? '₹' + data.toLocaleString('en-IN') : 'N/A';
        }
        return data;
        }
        }
        ]
        });
        table.clear();

        const rowData = [];
        data.forEach(item => {
        rowData.push([
        item.sector,
        item.doj,
        item.airlineCode,
        item.flightNo,
        item.targetFare,
        item.latestFare,
        item.entryDate
        ]);
        });
        table.rows.add(rowData).draw();
        }

        function formatYMD(dateObj) {
        const y = dateObj.getFullYear();
        const m = String(dateObj.getMonth() + 1).padStart(2, '0');
        const d = String(dateObj.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
        }

        // --- BULK FETCH CHART DATA ---
        function loadAllChartData(flights) {
        document.getElementById('chart-loading').style.display = 'block';

        // Map each flight to an individual fetch Promise
        const fetchPromises = flights.map(f => {
        const url = `/OccasionDetails/GetFareTrendChartData?sector=${encodeURIComponent(currentSector)}&date=${encodeURIComponent(currentTravelDate)}&airline=${encodeURIComponent(f.airlineCode)}&flightNo=${encodeURIComponent(f.flightNo)}`;
        return fetch(url).then(r => r.json()).then(res => ({
        flight: `${f.airlineCode} ${f.flightNo}`,
        targetFare: f.targetFare,
        success: res.success,
        data: res.data || []
        })).catch(() => ({ success: false })); // Failsafe
        });

        // Wait for all flight histories to download
        Promise.all(fetchPromises).then(results => {
        document.getElementById('chart-loading').style.display = 'none';
        processChartData(results);
        });
        }

        function processChartData(results) {
        const validResults = results.filter(r => r.success && r.data.length > 0);

        if (validResults.length === 0) {
        document.getElementById('chart-loading-text').innerText = "No historic fare entries found for any flights.";
        document.getElementById('chart-loading').style.display = 'block';
        document.querySelector('#chart-loading .spinner-border').style.display = 'none';
        return;
        }

        globalRawData = validResults.map(r => {
        return {
        flight: r.flight,
        targetFare: r.targetFare,
        history: r.data.map(item => {
        const edStr = item.entryDate;
        const datePart = edStr.split('T')[0];
        const stableDateObj = new Date(datePart + 'T12:00:00');
        const ed = new Date(edStr.replace('T', ' '));
        return {
        label: ed.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) + ' ' + ed.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        date: datePart,
        rawDateObj: stableDateObj,
        fare: item.fare,
        attemptCount: item.attemptCount || 0
        };
        })
        };
        });

        renderFlightToggles();

        // Calculate Universal Start and End Dates
        let allDates = [];
        globalRawData.forEach(r => {
        r.history.forEach(h => allDates.push(h.rawDateObj));
        });
        allDates.sort((a, b) => a - b);

        const maxDateObj = allDates[allDates.length - 1];
        const minDateObj = allDates[0];

        let targetStartObj = new Date(maxDateObj);
        targetStartObj.setDate(targetStartObj.getDate() - 15); // Changed to past 15 days

        if (targetStartObj < minDateObj) {
        targetStartObj = minDateObj;
        }

        document.getElementById('startDate').min = formatYMD(minDateObj);
        document.getElementById('startDate').max = formatYMD(maxDateObj);
        document.getElementById('startDate').value = formatYMD(targetStartObj);

        document.getElementById('endDate').min = formatYMD(minDateObj);
        document.getElementById('endDate').max = formatYMD(maxDateObj);
        document.getElementById('endDate').value = formatYMD(maxDateObj);

        document.getElementById('chart-overlay').style.display = 'block';

        initChart();
        updateChartFilters();
        }

        // Checkbox UI Generation
        function renderFlightToggles() {
        const container = document.getElementById('flightTogglesContainer');
        let html = '';
        globalRawData.forEach((f, index) => {
        const color = getColor(index);
        html += `
        <div class="form-check form-switch custom-switch" style="border: 1px solid #dee2e6; padding: 6px 15px 6px 40px; border-radius: 20px; background: #fff; cursor: pointer;">
        <input class="form-check-input" type="checkbox" id="toggle_${index}" checked onchange="toggleFlight(${index})" style="cursor: pointer;">
        <label class="form-check-label fw-bold" for="toggle_${index}" style="color: ${color}; cursor: pointer;">${f.flight}</label>
        </div>`;
        });
        container.innerHTML = html;
        }

        // Toggles visibility without reloading data
        function toggleFlight(index) {
        if (myChart) {
        const isChecked = document.getElementById(`toggle_${index}`).checked;
        myChart.setDatasetVisibility(index, isChecked);
        myChart.update();
        }
        }

        function toggleAllFlights() {
        allFlightsSelected = !allFlightsSelected;

        const btn = document.getElementById('btnToggleAll');
        btn.innerText = allFlightsSelected ? "Deselect All" : "Select All";

        if (allFlightsSelected) {
        btn.classList.replace('btn-outline-primary', 'btn-outline-secondary');
        } else {
        btn.classList.replace('btn-outline-secondary', 'btn-outline-primary');
        }

        globalRawData.forEach((f, index) => {
        const cb = document.getElementById(`toggle_${index}`);
        if (cb) {
        cb.checked = allFlightsSelected;
        if (myChart) {
        myChart.setDatasetVisibility(index, allFlightsSelected);
        }
        }
        });

        if (myChart) myChart.update();
        }

        function initChart() {
        const ctx = document.getElementById('myChart').getContext('2d');
        if (myChart) myChart.destroy();

        myChart = new Chart(ctx, {
        type: 'line',
        data: { labels: [], datasets: [] },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },

        onClick: (e, activeElements) => {
        if (activeElements.length > 0) {
        const element = activeElements[0];
        const dataset = myChart.data.datasets[element.datasetIndex];
        const attemptCount = dataset.attemptData[element.index];

        if (attemptCount > 0) {
        window.location.href = `/OccasionDetails/AttemptDetails?eventId=${currentEventId}&sector=${encodeURIComponent(currentSector)}&travelDate=${encodeURIComponent(currentTravelDate)}`;
        }
        }
        },

        onHover: (e, activeElements) => {
        if (activeElements.length > 0) {
        const ds = myChart.data.datasets[activeElements[0].datasetIndex];
        if (ds.attemptData && ds.attemptData[activeElements[0].index] > 0) {
        e.native.target.style.cursor = 'pointer';
        return;
        }
        }
        e.native.target.style.cursor = 'default';
        },

        plugins: {
        tooltip: {
        callbacks: {
        label: (context) => {
        let label = ` ${context.dataset.label}: ₹${context.raw ? context.raw.toLocaleString('en-IN') : '0'}`;
        if (context.dataset.attemptData && context.dataset.attemptData[context.dataIndex] > 0) {
        label += `  🎯 (${context.dataset.attemptData[context.dataIndex]} Attempts Logged! Click to view)`;
        }
        return label;
        }
        }
        }
        },
        scales: {
        y: {
        beginAtZero: true,
        ticks: { callback: (value) => '₹' + value.toLocaleString('en-IN') }
        }
        }
        }
        });
        }

        function updateChartFilters() {
        if (!myChart) return;
        const start = document.getElementById('startDate').value;
        const end = document.getElementById('endDate').value;

        if (start && end && start > end) {
        alert("End date cannot be before start date");
        return;
        }

        let filteredLabelsSet = new Set();
        let labelToRawDate = {};

        globalRawData.forEach(flight => {
        flight.history.forEach(h => {
        if ((!start || h.date >= start) && (!end || h.date <= end)) {
        filteredLabelsSet.add(h.label);
        labelToRawDate[h.label] = h.rawDateObj;
        }
        });
        });

        let sortedLabels = Array.from(filteredLabelsSet).sort((a, b) => labelToRawDate[a] - labelToRawDate[b]);
        myChart.data.labels = sortedLabels;
        myChart.data.datasets = [];

        globalRawData.forEach((flight, index) => {
        let dataPoints = [];
        let attemptPoints = [];

        sortedLabels.forEach(lbl => {
        const match = flight.history.find(h => h.label === lbl);
        dataPoints.push(match ? match.fare : null);
        attemptPoints.push(match ? match.attemptCount : 0);
        });

        const color = getColor(index);
        myChart.data.datasets.push({
        label: flight.flight,
        data: dataPoints,
        attemptData: attemptPoints,
        borderColor: color,
        backgroundColor: color + '1A',
        borderWidth: 2,
        tension: 0.3,
        fill: false,
        spanGaps: true,

        // DYNAMIC STYLING: Normal dots use 'circle', attempts use the custom graph-paper canvas!
        pointStyle: (ctx) => ctx.dataset.attemptData[ctx.dataIndex] > 0 ? attemptMarkerCanvas : 'circle',
        pointRadius: (ctx) => ctx.dataset.attemptData[ctx.dataIndex] > 0 ? 8 : 4,
        pointHoverRadius: (ctx) => ctx.dataset.attemptData[ctx.dataIndex] > 0 ? 10 : 6,
        pointBackgroundColor: (ctx) => ctx.dataset.attemptData[ctx.dataIndex] > 0 ? '#dc3545' : '#ffffff',
        pointBorderColor: (ctx) => ctx.dataset.attemptData[ctx.dataIndex] > 0 ? '#dc3545' : color,
        pointBorderWidth: 2
        });
        });

        // Benchmark Target Fare Line
        let avgTarget = globalRawData.length > 0 ? globalRawData[0].targetFare : 0;
        myChart.data.datasets.push({
        label: 'Sector Target Fare',
        data: sortedLabels.map(() => avgTarget),
        borderColor: '#343a40',
        borderWidth: 2,
        borderDash: [5, 5],
        fill: false,
        pointRadius: 0,
        hidden: false
        });

        // Restore Checkbox Visibility
        globalRawData.forEach((flight, index) => {
        const cb = document.getElementById(`toggle_${index}`);
        if (cb) myChart.setDatasetVisibility(index, cb.checked);
        });

        myChart.update();
        }

        function showError(msg) {
        document.getElementById('error-overlay').style.display = 'block';
        let formattedMsg = msg;
        if (msg.includes("Unauthorized") || msg.includes("401")) {
        formattedMsg += "<br><br><strong style='color:#b71c1c;'>Security Note:</strong> Your Azure session token has expired. <br><br> <a href='/Login/Logout' class='btn btn-danger btn-sm'>Refresh Token</a>";
        }
        document.getElementById('error-message').innerHTML = formattedMsg;
        }
    </script>
}