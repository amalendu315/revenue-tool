                                        <th onclick="handleSort('confstatus')" class="d-none d-lg-table-cell text-center"><div class="d-flex justify-content-center align-items-center">Conf. ${getIcon('confstatus')}</div></th>
                                        <th onclick="handleSort('remarks')" class="d-none d-xxl-table-cell"><div class="d-flex align-items-center">Remarks ${getIcon('remarks')}</div></th>
