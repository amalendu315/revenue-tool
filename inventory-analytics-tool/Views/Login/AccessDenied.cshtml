@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Uses your standard layout
}

<div class="page-content d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <!-- Icon -->
                <div class="mb-4">
                    <i class="mdi mdi-shield-lock-outline text-danger" style="font-size: 80px; opacity: 0.8;"></i>
                </div>
                
                <!-- Message -->
                <h2 class="fw-bold text-dark mb-3">Access Denied</h2>
                <p class="text-muted fs-5 mb-4">
                    Oops! You do not have the required permissions to view this page. If you believe this is a mistake, please contact your administrator.
                </p>
                
                <!-- Smart Back Button -->
                <button onclick="goBack()" class="btn btn-lg text-white shadow-sm" style="background-color: #4b6794; border-radius: 8px; padding: 10px 24px;">
                    <i class="mdi mdi-arrow-left me-2"></i> Return to Dashboard
                </button>
                
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function goBack() {
            // If they have a previous page in their history, send them back.
            // Otherwise, route them to the root so the LoginController can auto-route them to their correct dashboard.
            if (window.history.length > 1 && document.referrer.indexOf(window.location.host) !== -1) {
                window.history.back();
            } else {
                window.location.href = '/'; 
            }
        }
    </script>
}