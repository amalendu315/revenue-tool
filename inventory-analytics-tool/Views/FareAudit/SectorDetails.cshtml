@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- UI INTERACTION LOGIC (Native Table Hide/Show) -->
    <script>
        $(document).ready(function() {
            // URL Param Pre-Filter Logic
            const urlParams = new URLSearchParams(window.location.search);
            const passedSector = urlParams.get('sector');
            
            if (passedSector) {
                // Correct way to find and update the Sector dropdown text without crashing
                document.querySelectorAll('.fb-field').forEach(field => {
                    const label = field.querySelector('.fb-label');
                    if (label && label.textContent.trim() === 'Sector') {
                        const valDisplay = field.querySelector('.dd-val');
                        if (valDisplay) {
                            valDisplay.textContent = passedSector;
                            valDisplay.classList.remove('placeholder');
                        }
                    }
                });

                // Fetch dynamic data
                loadDetailedSectorData(passedSector);
            }

            function loadDetailedSectorData(sector) {
                $('#sectorDetailsTbody').html('<tr><td colspan="49" class="text-center py-4"><div class="spinner-border text-primary spinner-border-sm me-2"></div> Loading Sector Details...</td></tr>');

                const endpointUrl = `@Url.Action("GetSectorDetailsData", "FareAudit")?sector=${encodeURIComponent(sector)}`;

                fetch(endpointUrl)
                    .then(res => {
                        // FIX 2: Catch if IIS returns a 200 OK HTML page instead of JSON
                        const contentType = res.headers.get("content-type");
                        if (!contentType || !contentType.includes("application/json")) {
                            throw new TypeError("Server returned HTML instead of JSON. Check routing.");
                        }
                        return res.json();
                    })
                    .then(result => {
                        if (!result.success) {
                            $('#sectorDetailsTbody').html(`<tr><td colspan="49" class="text-center text-danger">${result.message}</td></tr>`);
                            return;
                        }
                        renderDetailedTable(result.data || []);
                    })
                    .catch(err => {
                        $('#sectorDetailsTbody').html(`<tr><td colspan="49" class="text-center text-danger">Network Error: ${err.message}</td></tr>`);
                    });
            }
                    // Bind the Search button to trigger the data fetch
        $('.btn-search').on('click', function(e) {
            e.preventDefault();

            let selectedSector = null;

            // Find the currently selected sector from your custom dropdown UI
            document.querySelectorAll('.fb-field').forEach(field => {
                const label = field.querySelector('.fb-label');
                if (label && label.textContent.trim() === 'Sector') {
                    const valDisplay = field.querySelector('.dd-val');
                    if (valDisplay && !valDisplay.classList.contains('placeholder')) {
                        selectedSector = valDisplay.textContent.trim();
                    }
                }
            });

            if (selectedSector) {
                // Trigger the fetch!
                loadDetailedSectorData(selectedSector);
            } else {
                alert("Please select a Sector from the dropdown first.");
            }
        });
            }

            function renderDetailedTable(data) {
                if (data.length === 0) {
                    $('#sectorDetailsTbody').html('<tr><td colspan="49" class="text-center text-muted py-4">No audit logs found for this sector in the last 30 days.</td></tr>');
                    return;
                }

                // Helper to format values elegantly
                const fVal = (val) => val === null || val === undefined || val === '' ? '<span class="text-muted">-</span>' : val;
                const fDate = (dateStr) => dateStr ? new Date(dateStr).toLocaleDateString('en-GB') : '<span class="text-muted">-</span>';
                const fTime = (dateStr) => dateStr ? new Date(dateStr).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '<span class="text-muted">-</span>';

                let html = '';
                data.forEach(row => {
                    html += `<tr> 
                        <td>${fVal(row.id)}</td>
                        <td>${fDate(row.requestDateTime)}</td>
                        <td><span class="text-muted">-</span></td> <!-- Agency (N/A in DB) -->
                        <td><span class="text-muted">-</span></td> <!-- Airport (N/A in DB) -->
                        <td class="fw-bold text-primary">${fVal(row.flightSector)}</td> 
                        <td><span class="text-muted">-</span></td> <!-- Fare Supportive -->
                        <td><span class="text-muted">-</span></td> <!-- D-7 -->
                        <td>${fVal(row.flightNumber).substring(0, 2)}</td> 
                        <td class="fw-bold">${fVal(row.pnr)}</td> 
                        <td>${fDate(row.travelDateTime)}</td>
                        <td>${fVal(row.flightNumber)}</td>
                        <td>${fTime(row.travelDateTime)}</td>
                        <td>${fVal(row.bookedPaxQty)}</td>
                        <td>${fVal(row.flightWiseAverageCost)}</td>
                        <td>${fVal(row.averageSellFare)}</td>
                        <td class="text-primary fw-bold">${fVal(row.actualManagedFare)}</td>
                        
                        <!-- FS Columns -->
                        <td>${fVal(row.fsSameFlightFare)}</td>
                        <td class="${row.fsLowestFlightFare > 0 ? 'text-danger fw-bold' : ''}">${fVal(row.fsLowestFlightFare)}</td>
                        <td>${fVal(row.fsLowestFareFlightNumber)}</td>
                        <td>${fVal(row.fsLowestFareFlightDepartureTime)}</td>
                        <td>${fVal(row.fsWindowedLowestFare)}</td>
                        <td>${fVal(row.fsWindowedLowestFareFlightNumber)}</td>
                        <td>${fVal(row.fsWindowedLowestFareDepartureTime)}</td>
                        <td><small>${fVal(row.fsErrorMessage)}</small></td>
                        
                        <!-- AO Columns -->
                        <td>${fVal(row.aoSameFlightFare)}</td>
                        <td class="${row.aoLowestFare > 0 ? 'text-danger fw-bold' : ''}">${fVal(row.aoLowestFare)}</td>
                        <td>${fVal(row.aoLowestFareFlightNumber)}</td>
                        <td>${fVal(row.aoLowestFareFlightDepartureTime)}</td>
                        <td>${fVal(row.aoWindowedLowestFare)}</td>
                        <td>${fVal(row.aoWindowedLowestFareFlightNumber)}</td>
                        <td>${fVal(row.aoWindowedLowestFareDepartureTime)}</td>
                        <td><small>${fVal(row.aoErrorMessage)}</small></td> 
                        
                        <!-- System Data -->
                        <td>${fDate(row.taskCompletedDateTime)} ${fTime(row.taskCompletedDateTime)}</td>
                        <td><span class="text-muted">-</span></td> <!-- Managed By -->
                        <td><small>${fVal(row.fareAuditRemarks)}</small></td>
                        <td><span class="badge bg-light text-dark border">${fVal(row.logType)}</span></td>
                        <td>${fVal(row.source)}</td> 
                        
                        <!-- Economics -->
                        <td>${fVal(row.flightWiseTotalSeatsPurchased)}</td>
                        <td>${fVal(row.flightWiseTotalSeatsSold)}</td>
                        <td>${fVal(row.flightWiseTotalSeatsLeft)}</td>
                        <td>${fVal(row.flightWiseAverageCost)}</td>
                        <td>${fVal(row.routeWiseSeatsPurchased)}</td>
                        <td>${fVal(row.routeWiseSeatsSold)}</td>
                        <td>${fVal(row.routeWiseSeatsLeft)}</td>
                        <td>${fVal(row.routeWiseAverageCost)}</td>
                        <td>${fVal(row.averageSellFare)}</td>
                        <td>${fDate(row.requestDateTime)}</td>
                        <td>
                            <span class="badge ${row.status === 'Completed' || row.status === 'Success' ? 'bg-success' : 'bg-warning'}">${fVal(row.status)}</span>
                        </td>
                        <td><small>${fVal(row.remark)}</small></td>
                    </tr>`;
                });

                $('#sectorDetailsTbody').html(html);

                // Run toggle logic to respect checkboxes immediately after data renders
                const columnBoxes = $('.col-toggle');
                columnBoxes.each(function() {
                    toggleNativeColumn(parseInt($(this).attr('data-col-index')), $(this).is(':checked'));
                });
            }

            // --- NATIVE COLUMN TOGGLE LOGIC ---
            const selectAllBox = $('#selectAllCheckbox');
            const columnBoxes = $('.col-toggle');

            function toggleNativeColumn(index, show) {
                const table = document.getElementById('sectorDetailsTable');
                if (!table) return;
                const rows = table.rows;
                for (let i = 0; i < rows.length; i++) {
                    const cell = rows[i].cells[index];
                    if (cell) {
                        if (show) cell.classList.remove('hide-column');
                        else cell.classList.add('hide-column');
                    }
                }
            }

            columnBoxes.on('change', function() {
                const colIdx = parseInt($(this).attr('data-col-index'));
                toggleNativeColumn(colIdx, $(this).is(':checked'));
                selectAllBox.prop('checked', columnBoxes.filter(':checked').length === columnBoxes.length);
            });

            selectAllBox.on('change', function() {
                const isChecked = $(this).is(':checked');
                columnBoxes.prop('checked', isChecked);
                columnBoxes.each(function() {
                    toggleNativeColumn(parseInt($(this).attr('data-col-index')), isChecked);
                });
            });

            // --- FILTER SEARCH ---
            document.getElementById('filterSearch').addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                document.querySelectorAll('#filterPanel .airlines label').forEach(label => {
                    if (label.id === 'selectAllLabel') return; 
                    label.style.setProperty('display', label.textContent.toLowerCase().includes(searchTerm) ? 'flex' : 'none', 'important'); 
                });
            });

            // --- DROPDOWN & POPUP LOGIC ---
            function closeAllPopups() {
                document.querySelectorAll('.dd-panel.show, .cal-panel.show, .filter-panel.show').forEach(p => p.classList.remove('show'));
            }

            document.querySelectorAll('.fb-field').forEach(field => {
                const trigger = field.querySelector('.dd-trigger');
                const panel = field.querySelector('.dd-panel');
                const searchInput = field.querySelector('.dd-search');
                const valDisplay = field.querySelector('.dd-val');
                if (!trigger || !panel) return;

                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpening = !panel.classList.contains('show');
                    closeAllPopups();
                    if (isOpening) {
                        panel.classList.add('show');
                        if (searchInput) { searchInput.value = ''; searchInput.focus(); }
                    }
                });

                panel.addEventListener('click', (e) => {
                    const item = e.target.closest('.dd-item');
                    if (item) {
                        e.stopPropagation();
                        panel.querySelectorAll('.dd-item').forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        valDisplay.textContent = item.textContent;
                        valDisplay.classList.remove('placeholder');
                        panel.classList.remove('show');
                    }
                });
            });

            const filterBtn = document.getElementById("filterBtn");
            const filterPanel = document.getElementById("filterPanel");
            if (filterBtn && filterPanel) {
                filterBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const isOpening = !filterPanel.classList.contains('show');
                    closeAllPopups();
                    if(isOpening) filterPanel.classList.add("show");
                });
            }

            document.addEventListener("click", (e) => {
                if (!e.target.closest('.fb-field') && !e.target.closest('.filter-container')) closeAllPopups();
            });
        });
    </script>
}