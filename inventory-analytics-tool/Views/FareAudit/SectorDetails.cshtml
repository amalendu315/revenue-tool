@{
    ViewData["Title"] = "Sector Details";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<style>
    .cox { max-width: 1400px; margin: auto; }
    .fb-row { display: flex; flex-wrap: wrap; gap: 15px; align-items: center; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 1px 2px rgba(56,65,74,.15); margin-bottom: 20px; }
    .fb-field { position: relative; display: flex; flex-direction: column; min-width: 180px; flex: 1; }
    .fb-label { font-size: 11px; text-transform: uppercase; color: #878a99; font-weight: 600; margin-bottom: 5px; }
    .dd-trigger, .cal-trigger { display: flex; justify-content: space-between; align-items: center; border: 1px solid #ced4da; padding: 8px 12px; border-radius: 4px; cursor: pointer; background: #fff; }
    .dd-val { font-size: 14px; color: #495057; }
    .dd-val.placeholder { color: #adb5bd; }
    .dd-icon { width: 16px; height: 16px; stroke: #495057; }
    
    .dd-panel, .cal-panel, .filter-panel { display: none; position: absolute; top: 100%; left: 0; background: #fff; border: 1px solid #ced4da; border-radius: 4px; box-shadow: 0 5px 10px rgba(30,32,37,.12); z-index: 1000; margin-top: 5px; }
    .dd-panel, .cal-panel { right: 0; max-height: 250px; overflow-y: auto; }
    .filter-panel { right: 0; left: auto; width: 300px; padding: 15px; max-height: 400px; overflow-y: auto; }
    .dd-panel.show, .cal-panel.show, .filter-panel.show { display: block; }
    
    .dd-search-wrap { padding: 10px; border-bottom: 1px solid #ced4da; position: sticky; top: 0; background: #fff; z-index: 2; }
    .dd-search { width: 100%; border: 1px solid #ced4da; padding: 6px; border-radius: 4px; outline: none; }
    .dd-list { position: relative; }
    .dd-item { padding: 8px 12px; cursor: pointer; font-size: 14px; color: #495057; transition: background-color 0.2s; }
    .dd-item:hover, .dd-item.selected { background: #f3f6f9; color: #0b5ed7; font-weight: 500; }
    
    .btn-search { background-color: #f06548; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; display: flex; align-items: center; gap: 5px; cursor: pointer; font-weight: 500; height: 38px; margin-top: 19px; }
    .filter-container { position: relative; display: inline-block; margin-top: 19px; margin-left: 10px; }
    .btn-filter { background-color: #fff; color: #495057; border: 1px solid #ced4da; padding: 8px 16px; border-radius: 4px; display: flex; align-items: center; gap: 5px; cursor: pointer; font-weight: 500; height: 38px; }
    
    .filter-section label { display: flex; margin-bottom: 8px; font-size: 13px; color: #495057; cursor: pointer; align-items: center; }
    .filter-section label input { margin-right: 8px; }
    .boxes { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 1px 2px rgba(56,65,74,.15); }
    
    .cal-header { display:flex; justify-content:space-between; align-items:center; padding:10px; border-bottom:1px solid #eee; font-weight:bold; }
    .cal-nav { background:none; border:none; cursor:pointer; font-size:18px; line-height:1; padding:0 10px; }
    .cal-grid { display:grid; grid-template-columns:repeat(7, 1fr); gap:5px; padding:10px; text-align:center; }
    .cal-dow { font-size:12px; color:#878a99; font-weight:600; }
    .cal-day { padding:5px; border-radius:4px; cursor:pointer; font-size:13px; }
    .cal-day:not(.empty):hover { background:#f3f6f9; }
    
    /* Native Table Styles */
    .native-table { width: 100%; border-collapse: collapse; white-space: nowrap; }
    .native-table th, .native-table td { padding: 8px 12px; border: 1px solid #e9ebec; font-size: 13px; }
    .native-table th { background: #f3f6f9; font-weight: 600; color: #495057; }
    
    /* CRITICAL: The class your native JS toggle logic relies on */
    .hide-column { display: none !important; }
</style>

